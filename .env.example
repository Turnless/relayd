# Copy to .env and fill in. Never commit .env.

# Claude API key (only needed to extract new logs and for free-form questions).
ANTHROPIC_API_KEY=

# Model used for extraction and the agent. Default: claude-opus-5-5.
# Set to claude-sonnet-5-5 for lower cost.
RELAYD_MODEL=claude-opus-5-5

# FalkorDB connection. Local/dev: falkor://localhost:16379
# FalkorDB Cloud: falkors://<user>:<password>@<host>:<port>
FALKORDB_URL=falkor://localhost:16379

# Only if your API key is not scoped to a workspace (error: "must include the
# anthropic-workspace-id header"). Console -> Settings -> Workspaces -> copy the ID.
ANTHROPIC_WORKSPACE_ID=

# FalkorDB Cloud (use instead of FALKORDB_URL; Vercel settings use these too).
# FALKORDB_HOST=
# FALKORDB_PORT=
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
